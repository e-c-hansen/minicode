<?xml version="1.0" encoding="utf-8"?>
<!-- One pane at a time: on a 576 by 640 dp screen there is no room to put the
     file list beside the editor, so it covers it and closes when a file opens.
     One bar at the top is all the chrome there is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252526"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="↑"
            android:textSize="16sp"
            android:textColor="#4EA1F7" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:textColor="#D4D4D4"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="@string/app_name" />

        <!-- Keyboards on phones vary enough that no key can be assumed, so
             every shortcut is also reachable here. -->
        <TextView
            android:id="@+id/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="⋮"
            android:textSize="18sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#252526" />

    <org.minicode.editor.CodeEditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:textColor="#D4D4D4"
        android:textColorHighlight="#264F78"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:padding="6dp"
        android:importantForAutofill="no"
        android:visibility="gone"
        android:hint="" />
</LinearLayout>

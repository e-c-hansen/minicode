<?xml version="1.0" encoding="utf-8"?>
<!-- One pane at a time: on a 576 by 640 dp screen there is no room to put the
     file list beside the editor, so it covers it and closes when a file opens.
     One bar at the top is all the chrome there is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252526"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="↑"
            android:textSize="16sp"
            android:textColor="#4EA1F7" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:textColor="#D4D4D4"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="@string/app_name" />

        <!-- Keyboards on phones vary enough that no key can be assumed, so
             every shortcut is also reachable here. -->
        <TextView
            android:id="@+id/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="⋮"
            android:textSize="18sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#252526" />

    <org.minicode.editor.CodeEditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:textColor="#D4D4D4"
        android:textColorHighlight="#264F78"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:padding="6dp"
        android:importantForAutofill="no"
        android:visibility="gone"
        android:hint="" />

    <!-- The language server's line: the diagnostic at the caret, or what the
         server is doing. Shown only with the editor, and only when it has
         something to say (LspSession.syncBar). -->
    <TextView
        android:id="@+id/lspBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252526"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/previewScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:visibility="gone">

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#D4D4D4"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.15"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- The LaTeX preview: typeset in Termux, every page, double tap to edit
         (LatexPreview.kt). -->
    <org.minicode.editor.LatexPreview
        android:id="@+id/latex"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Images and PDF pages, in the slot the editor would have. -->
    <ImageView
        android:id="@+id/media"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:scaleType="fitCenter"
        android:adjustViewBounds="false"
        android:contentDescription="@string/app_name"
        android:visibility="gone" />

    <!-- The browser panel, as on the Mac: a system web view with a URL bar.
         A phone has a browser a swipe away, so this is for looking something
         up without leaving the window. -->
    <LinearLayout
        android:id="@+id/browser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252526"
            android:textColor="#D4D4D4"
            android:textColorHint="#9CA3AF"
            android:hint="Search or type a URL"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri|textNoSuggestions"
            android:importantForAutofill="no" />

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <org.minicode.editor.TerminalView
        android:id="@+id/terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:visibility="gone" />

    <!-- Keys a phone keyboard lacks, for the terminal: filled in by
         TerminalKeys.kt, shown and hidden with the terminal. -->
    <HorizontalScrollView
        android:id="@+id/termKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/termKeyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The browser panel, and nothing else, needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- So the terminal can work in the folder that is open. The editor goes
         through the document picker and needs none of this; a shell has only
         file paths, and on Android 11 and later a path outside the app's own
         storage is readable only with "All files access", which the user
         grants in Settings when the terminal first asks. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Running language servers and tectonic that the user installed in
         Termux (see Termux.kt). Termux asks the user to allow this. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_fg"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiniCode">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

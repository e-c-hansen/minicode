#!/bin/bash
# CLI launcher for mutible, installed onto PATH as `mutible`. `mutible -h`
# says what it does. Paths go to the running mutible, so a file opens as a
# tab in an existing window; the terminal is free again at once.

usage() {
  cat <<'EOF'
Usage: mutible [options] [path ...]

Opens folders and files in mutible. With no path, opens the current folder.

  mutible              open the current folder
  mutible ~/project    open a folder, or bring forward the window showing it
  mutible notes.md     open a file as a tab in the window whose folder holds
                        it, else in the window in front (so, typed in
                        mutible's own terminal, in that window)
  mutible a.py b.py    open several files at once
  mutible https://example.com
                        open a web page in a browser tab of the browser
                        window, the window on your bookmark folder
                        (~/Bookmarks, or browser.bookmarks in settings);
                        several addresses open as several tabs
  mutible ssh://thinkpad/~/proj
                        open a folder (or a file) on another machine: its
                        files, terminals and saving are that machine's,
                        through your own ssh and a mutible installed there
                        (ssh://[user@]host[:port]/path; /~ is its home)

These are VS Code's rules for `code`: a file joins a window you already
have, and a folder gets its own window unless you ask for the one in front.

Options:
  -r, --reuse-window open everything in the window in front: a folder
                     replaces its folder (after asking about unsaved files),
                     and files open there even when another window's folder
                     holds them
  -n, --new-window   open the path in a new window of its own, a separate
                     mutible, even when a window already shows it
  -v, --version      print the version
  -h, --help         print this help

Opening from Finder (Open With, or a drop on the Dock icon) follows the same
rules as a file named here. A web bookmark (a .url or .webloc file) opens
its page in the browser window instead; several opened together open as
tabs of it.

  mutible install-skill [--dir DIR]
                     install the Claude Code skill that teaches Claude to
                     show its work in mutible, in DIR (by default
                     ~/.claude/skills/mutible, or under $CLAUDE_CONFIG_DIR);
                     run it again after an upgrade

Subcommands drive the running mutible instead, without bringing it to the
front (a word below is always a subcommand; write ./open for a file of that
name). `mutible help <command>` says more about one.

EOF
  if [ -x "$cli" ]; then "$cli" help
  else echo "(This copy has no control channel.)"; fi
}

# rename-mutible: keep-begin
# Run as `minicode`, its name before 1.6.0 (Homebrew links that name too),
# it says the name is now mutible: on a terminal only, and never for a
# Claude Code hook (`minicode notify --from-hook`), which stays silent.
if [ "$(basename "${BASH_SOURCE[0]}")" = minicode ] && [ -t 2 ]; then
  from_hook=0
  if [ "$1" = notify ]; then
    for a in "$@"; do [ "$a" = --from-hook ] && from_hook=1; done
  fi
  [ $from_hook = 1 ] ||
    echo "minicode is now called mutible (or mbl); the minicode command will go in a later release" >&2
fi
# rename-mutible: keep-end

# Resolve this script's real location, following the Homebrew symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
dir="$(cd -P "$(dirname "$src")" && pwd)"
# The launcher lives in Contents/Resources, the binary in Contents/MacOS.
bundle="$(cd -P "$dir/../.." && pwd)"
binary="$bundle/Contents/MacOS/Mutible"
# The control channel's client: `mutible open`, `state`, `term` and the
# other subcommands talk to the running mutible through it.
cli="$bundle/Contents/MacOS/mutible-cli"

# Installs the Claude Code skill shipped in the bundle (or, run from a
# checkout's scripts/, the checkout's own), as `make install` does.
install_skill() {
  local skill="$bundle/Contents/Resources/skills/mutible/SKILL.md"
  [ -f "$skill" ] || skill="$dir/../skills/mutible/SKILL.md"
  if [ ! -f "$skill" ]; then
    echo "mutible: this copy has no skill to install" >&2
    return 3
  fi
  local to="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/mutible"
  local given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) [ -n "$2" ] || { echo "mutible: --dir needs a folder" >&2; return 2; }
             to="$2"; given=1; shift ;;
      -h|--help) echo "Usage: mutible install-skill [--dir DIR]"; return 0 ;;
      *) echo "mutible: install-skill: unexpected $1" >&2; return 2 ;;
    esac
    shift
  done
  if cmp -s "$skill" "$to/SKILL.md"; then
    echo "The mutible skill in $to is up to date"
    return 0
  fi
  mkdir -p "$to" && cp "$skill" "$to/SKILL.md" || return 1
  echo "Installed the mutible skill in $to"
  # The skill as installed before the rename is left alone; say where it is,
  # so Claude Code does not load both.
  local old="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/minicode"   # rename-mutible: keep
  if [ $given = 0 ] && [ "$old" != "$to" ] && [ -f "$old/SKILL.md" ]; then
    echo "The skill from before the rename is still in $old; remove that folder so Claude Code loads only the new one"
  fi
}

# The words below are the control channel's subcommands, which
# ControlChannel::isSubcommand lists too; the core tests
# (control:launcher-words) check the two lists agree.
case "$1" in
  install-skill) shift; install_skill "$@"; exit $? ;;
  open|window|browse|term|diff|split|state|selection|term-output|tour|procs|notify|hooks|page|open-url|host|attach|statusline|help)
    if [ ! -x "$cli" ]; then
      # A hook runs `mutible notify`; it must never fail because of us.
      if [ "$1" = notify ]; then [ -t 0 ] || cat >/dev/null 2>&1; exit 0; fi
      # Nor may the status line: what it would chain to still runs.
      if [ "$1" = statusline ]; then
        input="$(cat)"
        if [ "$2" = --then ] && [ -n "$3" ]; then printf '%s' "$input" | /bin/sh -c "$3"
        else echo "Claude Code"; fi
        exit 0
      fi
      echo "mutible: this copy has no control channel ($cli is missing)" >&2
      exit 3
    fi
    exec "$cli" "$@" ;;
esac

new_window=0
reuse=0
paths=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version)
      v="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \
           "$bundle/Contents/Info.plist" 2>/dev/null)"
      echo "mutible ${v:-unknown}"
      exit 0 ;;
    -n|--new-window) new_window=1 ;;
    -r|--reuse-window) reuse=1 ;;
    --) shift; paths+=("$@"); break ;;
    -?*)
      echo "mutible: unknown option $1" >&2
      echo "Try 'mutible --help'." >&2
      exit 2 ;;
    *) paths+=("$1") ;;
  esac
  shift
done
# Web addresses go to the browser window, and ssh:// addresses to windows
# on other machines, each as a request of their own below.
urls=()
remote=()
rest=()
for p in "${paths[@]}"; do
  case "$p" in
    [Hh][Tt][Tt][Pp]://*|[Hh][Tt][Tt][Pp][Ss]://*) urls+=("$p") ;;
    [Ss][Ss][Hh]://*) remote+=("$p") ;;
    *) rest+=("$p") ;;
  esac
done
paths=()
[ ${#rest[@]} -gt 0 ] && paths=("${rest[@]}")
[ ${#paths[@]} -eq 0 ] && [ ${#urls[@]} -eq 0 ] && [ ${#remote[@]} -eq 0 ] && paths=("$PWD")

# The app's own output is discarded below, so say here if a path or an
# address is wrong.
status=0
found=()
web=()
for u in "${urls[@]}"; do
  case "$u" in
    *[[:space:][:cntrl:]]*|[Hh][Tt][Tt][Pp]://|[Hh][Tt][Tt][Pp][Ss]://|*://[/?#]*)
      echo "mutible: $u: not a web address" >&2
      status=1 ;;
    *) web+=("$u") ;;
  esac
done
ssh=()
for u in "${remote[@]}"; do
  case "$u" in
    *[[:space:][:cntrl:]]*|[Ss][Ss][Hh]://|[Ss][Ss][Hh]://[/?#]*)
      echo "mutible: $u: not an ssh:// address (ssh://[user@]host[:port]/path)" >&2
      status=1 ;;
    *) ssh+=("$u") ;;
  esac
done
for p in "${paths[@]}"; do
  if [ ! -e "$p" ]; then
    echo "mutible: $p: no such file or directory" >&2
    status=1
    continue
  fi
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  found+=("$p")
done
[ ${#found[@]} -eq 0 ] && [ ${#web[@]} -eq 0 ] && [ ${#ssh[@]} -eq 0 ] && exit 1

# For tests: print what would run instead of running it.
run() {
  if [ -n "$MUTIBLE_LAUNCHER_DRYRUN" ]; then printf '%q ' "$@"; echo
  else "$@"; fi
}

if [ $new_window = 1 ] && [ $reuse = 1 ]; then
  echo "mutible: --new-window and --reuse-window do not go together" >&2
  exit 2
fi

# Launch Services passes only paths, so -r goes as a request file the app
# reads and deletes: "mutible-open-1", "reuse", the paths, each ended by a
# NUL, in $TMPDIR/Mutible-open (the app reads that folder only). Web
# addresses go the same way, as "web" and the addresses, and ssh://
# addresses as "ssh" and the addresses.
request() {
  local mode="$1"; shift
  req_dir="${TMPDIR:-/tmp}"
  req_dir="${req_dir%/}/Mutible-open"
  mkdir -p "$req_dir" || exit 1
  tmp="$(mktemp "$req_dir/request.XXXXXX")" || exit 1
  { printf 'mutible-open-1\0%s\0' "$mode"; printf '%s\0' "$@"; } >"$tmp"
  req="$tmp.mutible-open"
  mv "$tmp" "$req" || exit 1
}

if [ $new_window = 1 ] && [ ${#web[@]} -gt 0 ]; then
  echo "mutible: --new-window opens a path, not a web address" >&2
  exit 2
fi
if [ $new_window = 1 ] && [ ${#ssh[@]} -gt 0 ]; then
  echo "mutible: --new-window opens a path, not an ssh:// address" >&2
  exit 2
fi

if [ $reuse = 1 ] && [ ${#found[@]} -gt 0 ]; then
  request reuse "${found[@]}"
  found=("$req")
fi
if [ ${#web[@]} -gt 0 ]; then
  request web "${web[@]}"
  found+=("$req")
fi
if [ ${#ssh[@]} -gt 0 ]; then
  request ssh "${ssh[@]}"
  found+=("$req")
fi

if [ $new_window = 1 ]; then
  # A process of its own, as the launcher used to start every time; the
  # binary takes one path.
  if [ ${#found[@]} -gt 1 ]; then
    echo "mutible: --new-window opens one path; opening ${found[0]}" >&2
  fi
  if [ -n "$MUTIBLE_LAUNCHER_DRYRUN" ]; then run "$binary" "${found[0]}"
  else "$binary" "${found[0]}" >/dev/null 2>&1 & fi
elif ps -axo comm= | grep -q "/Mutible$"; then
  # A mutible is running, maybe another copy of the app (a build that
  # Request a Change restarted into): hand the paths to it.
  run open -b ai.ible.mutible "${found[@]}"
else
  run open -a "$bundle" "${found[@]}"
fi
exit $status

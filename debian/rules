#!/usr/bin/make -f
# mutible's GTK 4 port lives in linux/. Its Meson build also compiles the
# shared C++ core from ../src and reads the version from ../Info.plist, which
# is why the source package is the whole repository.
#
# Two binary packages (debian/control): mutible, the app, and minicode, the
# transitional package for the name before 1.6.0, which holds only its docs.
# With two packages dh_auto_install installs into debian/tmp, and
# debian/mutible.install takes every file from there; dh_missing fails the
# build on any installed file it does not name, so a file the Meson build
# starts installing is never left out of the package unseen.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson --sourcedirectory=linux

# Every optional panel is forced on, so a missing build dependency fails the
# configure step instead of quietly building an editor without a terminal,
# browser, PDF viewer or web pictures. dh passes --buildtype=plain and the
# compiler flags come from dpkg-buildflags (-O2 -g plus hardening), the same
# optimization as the project's own debugoptimized default; dh_strip then
# moves the symbols into the mutible-dbgsym package.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Dterminal=enabled \
		-Dbrowser=enabled \
		-Dpdf=enabled \
		-Dwebimages=enabled

# The port's own tests (meson test), then the core suite the Mac build runs
# (make test at the top level, which builds into build/). Neither needs a
# display or the network.
# Timing bounds are skipped: Launchpad's builders are shared, and a bound
# measures the machine there, not the code (CI's jobs keep them).
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	dh_auto_test
	MC_SKIP_TIMING=1 $(MAKE) test
endif

override_dh_missing:
	dh_missing --fail-missing

# The terminal's BROWSER is /usr/share/mutible/mutible-browser.js, run as a
# program (sh and JavaScript at once), so it keeps the 0755 the Meson build
# gives it: dh_fixperms makes every .js file 0644.
override_dh_fixperms:
	dh_fixperms -Xmutible-browser.js
